# Loaded by Vite automatically when running `npm run dev` (vite dev server,
# mode "development"). Only variables prefixed with VITE_ are exposed to
# client code / index.html's %VITE_...% interpolation -- see
# https://vite.dev/guide/env-and-mode.html
#
# craftools_api running locally (XAMPP htdocs/craftools_api), DocumentRoot
# NOT changed -- so the base still includes /public. Matches ApiDataLoader.ts,
# which appends "/v1/?resource=..." to this value itself, so this must NOT
# include /v1.
VITE_API_BASE=http://127.0.0.1/craftools_api/public
