{
  "compilerOptions": {
    // Target modern browsers — aligns with our min-browser requirements (Chrome 80+)
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Allow existing .js files to coexist during incremental migration
    "allowJs": true,
    "checkJs": false,

    // Needed so craftools.ts can import Editor.ts explicitly (see below) --
    // without this, ".ts" in an import specifier is a type error.
    "allowImportingTsExtensions": true,

    // Start permissive; enable strict per directory as files are migrated to .ts
    "strict": true,
    "noEmit": true,

    // Path aliases (must mirror vite.config.ts)
    "paths": {
      "@tools/*":      ["./craftools/tools/*"],
      "@utils/*":      ["./craftools/utils/*"],
      "@settings/*":   ["./craftools/settings/*"],
      "@components/*": ["./craftools/components/*"]
    },

    // Node types for vite.config.ts (path, url, dirname, etc.)
    "types": ["node"],

    // Interop
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "craftools/**/*",
    "main.ts",
    "craftools.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vite.config.ts"
  ]
}
